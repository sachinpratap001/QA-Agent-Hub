{
  "name": "qa-test-suite",
  "version": "1.0.0",
  "scripts": {
    "test:api": "jest tests/api --runInBand --forceExit --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@playwright/test": "^1.40.0",
    "jest-junit": "^16.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "reporters": [
      "default",
      "jest-junit"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage"
  }
}
